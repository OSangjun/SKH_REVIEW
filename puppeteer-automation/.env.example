# ── Browser Automation Tool — Environment Variables ───────────────────────────
#
# Copy this file to .env and fill in values for your environment.
# server.js / mcp-server.js / run-tests.js 등이 require("dotenv").config() 로 로드함.
#
# 모든 변수는 소스 코드에서 process.env.<NAME> 으로 참조됨.
#
# Required ─────────────────────────────────────────────────────────────────────

# Absolute path to the Chromium / Chrome executable used by Puppeteer.
# Default (if unset): /opt/pw-browsers/chromium-1194/chrome-linux/chrome
# 참조: server.js, mcp-server.js, run-tests.js, src/recorder.js, src/replayer.js,
#       test-setup.js, test-elplus.js, test-elplus-10.js
CHROME_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Optional — Web UI / CLI ─────────────────────────────────────────────────────

# TCP port the web UI server listens on.
# Default: 3000
# 참조: server.js
PORT=3000

# Base URL override for run-tests.js (CLI test runner).
# Replaces the origin of all recorded URLs so the same recording can be
# replayed against a different environment (staging, QA, etc.).
# 동등 옵션: --base-url <url>
# 참조: run-tests.js
BASE_URL=

# Optional — AI 분석 (Spring Boot/Frontend 소스 기반 테스트 케이스 도출) ──────

# Anthropic Claude API key. Required only when running auto-analysis via the
# web UI's "분석" 기능. 미설정 시 분석 호출에서 에러 메시지 반환.
# 참조: src/server/analyzer.js
ANTHROPIC_API_KEY=

# Optional — GitLab 통합 (read_file / find_files 가 GitLab API 모드로 동작) ──
#
# GITLAB_URL + GITLAB_TOKEN 이 설정되면 MCP의 소스 조회 툴이 GitLab API를 사용.
# 미설정 시 로컬 파일시스템에서 읽음.
# 참조: mcp-server.js, src/server/gitlab-client.js

# GitLab 인스턴스 베이스 URL (예: https://gitlab.com)
GITLAB_URL=

# Personal/Project Access Token (read_api, read_repository 권한 필요)
GITLAB_TOKEN=

# 프로젝트 경로(group/repo) 또는 숫자 ID.
# NOTE: 신규 구조에서는 현재 페이지 URL(https://{GITLAB_URL}/{project}/...)에서
#       프로젝트를 자동 추출하고, 참조 브랜치는 md 지식 파일에서 읽도록 전환
#       중입니다. gitlab-client.js 가 아직 이 변수를 사용하므로 호환 목적으로
#       남겨두며, 마이그레이션 완료 후 제거 예정.
GITLAB_PROJECT=
