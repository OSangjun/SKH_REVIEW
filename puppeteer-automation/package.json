{
  "name": "puppeteer-browser-automation",
  "version": "1.0.0",
  "description": "Records and replays user keyboard/mouse interactions via Puppeteer",
  "main": "src/index.js",
  "scripts": {
    "start": "node server.js",
    "test": "node run-tests.js --all --fast",
    "test:slow": "node run-tests.js --all",
    "test:junit": "node run-tests.js --all --fast --junit test-results.xml",
    "cli:record": "node src/index.js record",
    "cli:replay": "node src/index.js replay"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "element-plus": "^2.13.7",
    "express": "^5.2.1",
    "puppeteer-core": "^24.42.0",
    "vue": "^3.5.33",
    "ws": "^8.20.0"
  }
}
